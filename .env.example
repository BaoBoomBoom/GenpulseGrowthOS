# Copy to .env.local for local API, or rely on `vercel env pull`
# Vercel Supabase / Edge Config integrations inject these automatically in Production.

# Supabase (from Vercel Storage ? Supabase)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# fallbacks also accepted:
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Edge Config (from Vercel Storage ? Global Config Store)
# EDGE_CONFIG=https://edge-config.vercel.com/ecfg_xxx?token=...

# Optional local file override
# OS_STORE_PATH=/absolute/path/to/os-store.json
